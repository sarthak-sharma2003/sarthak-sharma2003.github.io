---
// One stroke weight, one grid: every icon on the site comes from here.
interface Props { name: 'out' | 'down' | 'mail'; class?: string }
const { name, class: cls = '' } = Astro.props;
---

<svg class={`icon icon-${name} ${cls}`} viewBox="0 0 20 20" fill="none" stroke="currentColor"
  stroke-width="2.2" stroke-linecap="square" aria-hidden="true">
  {name === 'out' && <path d="M6 14 14 6M7 6h7v7" />}
  {name === 'down' && <path d="M10 3v13M4.5 10.5 10 16l5.5-5.5" />}
  {name === 'mail' && <path d="M3 5h14v10H3zM3 5l7 6 7-6" />}
</svg>
