---
// Hero: the player-intro card. Cobalt pitch, Edmonton snow, cartoon
// Sarthak in front of his number, and a live ticker along the bottom.
import Mascot from './Mascot.astro';
import Icon from './Icon.astro';
import { projects } from '../data/projects';

const liveCount = projects.filter((p) => p.status === 'live').length;
const liveTitles = projects.filter((p) => p.status === 'live').map((p) => p.title);
---

<section id="top" class="hero on-cobalt">
  <canvas id="snow" aria-hidden="true"></canvas>
  <svg class="pitch" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path d="M1030 -10V910" />
    <circle cx="1030" cy="520" r="230" />
    <circle cx="1030" cy="520" r="6" fill="currentColor" />
  </svg>

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 class="name"><span>Sarthak</span><span>Sharma</span></h1>
      <p class="position cap"><span>Software · Data · Analytics</span></p>
      <p class="lede">
        I build web scrapers, data pipelines, and AI agents that do real work.
        Computing Science + Business at the University of Alberta, Edmonton.
      </p>
      <div class="cta-row">
        <a class="btn btn-volt" href="mailto:sarthak7@ualberta.ca">Email me<Icon name="out" /></a>
        <a class="btn btn-line" href="#projects">See the work<Icon name="down" /></a>
      </div>
      <dl class="stats">
        <div><dt class="cap">Live projects</dt><dd>{liveCount}</dd></div>
        <div><dt class="cap">Internships</dt><dd>2</dd></div>
        <div><dt class="cap">PCL BT AI Challenge</dt><dd>3rd</dd></div>
      </dl>
    </div>

    <div class="player" aria-hidden="true">
      <span class="squad">07</span>
      <Mascot />
    </div>
  </div>

  <div class="ticker cap">
    <span class="live-tab"><i></i>Live</span>
    <div class="ticker-window">
      <div class="track">
        {[0, 1].map((copy) => (
          <ul aria-hidden={copy === 1 ? 'true' : undefined}>
            <li>Edmonton <b class="t-wx">·· °C</b></li>
            <li><b class="t-clock">--:--:--</b> MT</li>
            <li>Last push <b class="t-push">…</b></li>
            <li>Open to <b>software, data &amp; analytics roles</b></li>
            {liveTitles.map((t) => <li>Live now <b>{t}</b></li>)}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-top: 92px;
    overflow: hidden;
    background:
      radial-gradient(ellipse 46% 60% at 74% 42%, rgba(255, 255, 255, 0.16), transparent 70%),
      var(--cobalt);
    color: var(--n0);
  }

  #snow, .pitch {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  #snow { z-index: 3; }
  .pitch { color: rgba(255, 255, 255, 0.15); }
  .pitch path, .pitch circle:not([fill]) {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    flex: 1;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 24px;
  }
  .hero-copy {
    align-self: center;
    padding: 24px 0 56px;
  }

  .name {
    font-size: clamp(3.1rem, 9.4vw, 6rem);
    font-weight: 900;
    font-style: italic;
    font-stretch: 125%;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 0.86;
  }
  .name span { display: block; padding-right: 0.08em; }
  .name span + span { color: var(--volt); }

  .position {
    margin-top: 26px;
    display: inline-block;
    background: var(--n0);
    color: var(--cobalt);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    font-weight: 800;
    padding: 9px 30px 8px 16px;
    clip-path: polygon(0 0, 100% 0, calc(100% - 14px) 100%, 0 100%);
  }

  .lede {
    margin-top: 22px;
    max-width: 50ch;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--cobalt-tint);
  }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }

  .stats {
    margin-top: 40px;
    display: inline-grid;
    grid-auto-flow: column;
    background: var(--cobalt-night);
    clip-path: polygon(0 0, 100% 0, calc(100% - 16px) 100%, 0 100%);
  }
  .stats div { padding: 12px 34px 12px 18px; display: flex; flex-direction: column-reverse; }
  .stats div + div { border-left: 1px solid var(--cobalt-line); }
  .stats dt { font-size: 0.74rem; color: var(--cobalt-tint); }
  .stats dd {
    font-size: 2.3rem;
    font-weight: 800;
    font-stretch: 70%;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--n0);
  }

  .player {
    position: relative;
    align-self: end;
    height: min(76svh, 700px);
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }
  .squad {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -54% 0;
    font-size: min(58svh, 30vw, 520px);
    font-weight: 900;
    font-style: italic;
    font-stretch: 62%;
    line-height: 0.82;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.3);
    user-select: none;
  }

  /* ── ticker ──────────────────────────────────────────────── */
  .ticker {
    position: relative;
    z-index: 4;
    display: flex;
    height: 50px;
    background: var(--n10);
    font-size: 0.92rem;
    font-weight: 600;
  }
  .live-tab {
    flex: none;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 0 26px 0 var(--gutter);
    background: var(--volt);
    color: var(--n10);
    font-weight: 800;
    clip-path: polygon(0 0, 100% 0, calc(100% - 14px) 100%, 0 100%);
  }
  .live-tab i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--n10);
    animation: pulse 1.4s ease-in-out infinite;
  }
  @keyframes pulse { 50% { opacity: 0.2; } }

  .ticker-window { flex: 1; overflow: hidden; display: flex; align-items: center; }
  .track { display: flex; width: max-content; animation: marquee 48s linear infinite; }
  .ticker:hover .track { animation-play-state: paused; }
  .track ul { display: flex; list-style: none; min-width: 100vw; }
  .track li { white-space: nowrap; padding: 0 22px; color: var(--n4); }
  .track li::after { content: '/'; margin-left: 44px; color: var(--n7); }
  .track b { color: var(--n0); font-weight: 700; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* ── the one authored moment: the graphic animates on ───── */
  @keyframes wipe {
    from { clip-path: inset(-20% 100% -20% 0); }
    to { clip-path: inset(-20% -10% -20% 0); }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(26px); } }
  @keyframes slide { from { opacity: 0; transform: translateX(-30px); } }
  .name span { animation: wipe 0.9s var(--ease) 0.1s backwards; }
  .name span + span { animation-delay: 0.22s; }
  .position { animation: slide 0.7s var(--ease) 0.42s backwards; }
  .lede, .cta-row { animation: rise 0.8s var(--ease) 0.52s backwards; }
  .stats { animation: slide 0.8s var(--ease) 0.66s backwards; }
  .squad { animation: rise 1.2s var(--ease) 0.15s backwards; }
  .player :global(.mascot) { animation: rise 1s var(--ease) 0.35s backwards; }
  .ticker { animation: rise 0.8s var(--ease) 0.75s backwards; }

  @media (max-width: 880px) {
    .hero { padding-top: 80px; }
    .hero-grid { grid-template-columns: 1fr; gap: 0; }
    .hero-copy { padding-bottom: 8px; }
    .player { height: 330px; margin-top: 8px; }
    .squad { font-size: 300px; }
    .stats { display: grid; grid-auto-flow: row; grid-template-columns: repeat(3, auto); }
    .stats div { padding: 10px 18px 10px 14px; }
    .stats dd { font-size: 1.9rem; }
  }
  @media (max-width: 420px) {
    .stats dt { font-size: 0.64rem; }
    .stats div { padding: 10px 14px 10px 12px; }
  }
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Edmonton snow ────────────────────────────────────────────
  const canvas = document.getElementById('snow') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  interface Flake { x: number; y: number; r: number; vy: number; vx: number; o: number }
  let flakes: Flake[] = [];
  let W = 0, H = 0;

  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    W = canvas.offsetWidth;
    H = canvas.offsetHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  const spawn = (): Flake => ({
    x: Math.random() * W, y: Math.random() * -H,
    r: 0.8 + Math.random() * 2.4, vy: 0.35 + Math.random() * 0.8,
    vx: -0.15 + Math.random() * 0.3, o: 0.35 + Math.random() * 0.55,
  });
  function tick() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#ffffff';
    const t = performance.now() / 3000;
    for (const f of flakes) {
      f.y += f.vy;
      f.x += f.vx + Math.sin(t + f.y / 60) * 0.18;
      if (f.y > H + 4) { f.y = -4; f.x = Math.random() * W; }
      ctx.globalAlpha = f.o;
      ctx.beginPath();
      ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
    if (!document.hidden) requestAnimationFrame(tick);
  }
  if (!reduced) {
    resize();
    flakes = Array.from({ length: Math.min(120, Math.floor(W / 11)) }, spawn);
    addEventListener('resize', resize);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) requestAnimationFrame(tick); });
    requestAnimationFrame(tick);
  }

  // ── live Edmonton weather (Open-Meteo, no key) ───────────────
  const setAll = (cls: string, text: string) =>
    document.querySelectorAll(cls).forEach((el) => { el.textContent = text; });
  const WMO: Record<number, string> = {
    0: 'clear', 1: 'mostly clear', 2: 'partly cloudy', 3: 'overcast',
    45: 'fog', 48: 'fog', 51: 'drizzle', 61: 'rain', 63: 'rain', 65: 'rain',
    71: 'snow', 73: 'snow', 75: 'snow', 77: 'snow', 80: 'showers',
    85: 'snow showers', 86: 'snow showers', 95: 'thunderstorm',
  };
  fetch('https://api.open-meteo.com/v1/forecast?latitude=53.55&longitude=-113.49&current_weather=true')
    .then((r) => r.json())
    .then((d) => {
      const cw = d.current_weather;
      const desc = WMO[cw.weathercode] ?? '';
      setAll('.t-wx', `${Math.round(cw.temperature)}°C${desc ? ', ' + desc : ''}`);
    })
    .catch(() => setAll('.t-wx', 'probably cold'));

  // ── local clock (Mountain Time) ──────────────────────────────
  const fmt = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/Edmonton', hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit',
  });
  const tickClock = () => setAll('.t-clock', fmt.format(new Date()));
  tickClock();
  setInterval(tickClock, 1000);
</script>
