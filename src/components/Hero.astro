---
// Hero: a floodlit cold open. Four light banks slam on in the snow, the
// player card flips in, and a real ball drops onto the pitch to be kicked
// around (it knocks the letters of the name). Live ticker along the bottom.
import Mascot from './Mascot.astro';
import Icon from './Icon.astro';
import { projects } from '../data/projects';

const liveCount = projects.filter((p) => p.status === 'live').length;
const liveTitles = projects.filter((p) => p.status === 'live').map((p) => p.title);
const towers = ['t1', 't2', 't3', 't4'];
---

<section id="top" class="hero on-cobalt">
  <!-- the cold open plays once per visit, and never when landing on a #section -->
  <script is:inline>
    try {
      if (sessionStorage.getItem('ss-intro') || location.hash) document.documentElement.classList.add('lit');
      sessionStorage.setItem('ss-intro', '1');
    } catch (e) {}
  </script>
  <svg class="pitch" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path d="M1030 -10V910" />
    <circle cx="1030" cy="520" r="230" />
    <circle cx="1030" cy="520" r="6" fill="currentColor" />
  </svg>

  <!-- the cold open: night, then four floodlight banks one by one -->
  <div class="night" aria-hidden="true"></div>
  {towers.map((t) => <span class={`beam ${t}`} aria-hidden="true"></span>)}
  {towers.map((t) => (
    <svg class={`tower ${t}`} viewBox="0 0 132 64" aria-hidden="true">
      <rect x="1" y="1" width="130" height="62" fill="#0a0c16" />
      {[0, 1, 2].map((r) => [0, 1, 2, 3, 4].map((c) => (
        <circle class="lamp" cx={18 + c * 24} cy={14 + r * 18} r="7.5" />
      )))}
    </svg>
  ))}

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 class="name" aria-label="Sarthak Sharma">
        {['Sarthak', 'Sharma'].map((word, w) => (
          <span class="word" aria-hidden="true">
            {[...word].map((ch, i) => <span class="ch" style={`--i:${w * 7 + i}`}>{ch}</span>)}
          </span>
        ))}
      </h1>
      <p class="position cap"><span>Software · Data · Analytics</span></p>
      <p class="lede">
        I build web scrapers, data pipelines, and AI agents that do real work.
        Computing Science + Business at the University of Alberta, Edmonton.
      </p>
      <div class="cta-row">
        <a class="btn btn-volt" href="mailto:sarthak7@ualberta.ca">Email me<Icon name="out" /></a>
        <a class="btn btn-line" href="#projects">See the work<Icon name="down" /></a>
      </div>
    </div>

    <div class="card-stage">
      <div class="card" id="card" role="img"
        aria-label={`Player card: Sarthak Sharma, number 07. ${liveCount} live apps, 2 internships, 3rd in PCL's AI Challenge.`}>
        <div class="card-back" aria-hidden="true"><span>SS</span></div>
        <div class="card-front" aria-hidden="true">
          <span class="foil"></span>
          <span class="c-no">07</span>
          <span class="c-pos cap">CS + Business<br />UAlberta</span>
          <span class="c-city cap">Edmonton, AB</span>
          <div class="c-player"><Mascot /></div>
          <div class="c-name">Sharma</div>
          <dl class="c-stats">
            <div><dd>{liveCount}</dd><dt class="cap">Live apps</dt></div>
            <div><dd>2</dd><dt class="cap">Internships</dt></div>
            <div><dd>3rd</dd><dt class="cap">PCL AI Challenge</dt></div>
          </dl>
          <span class="glare"></span>
        </div>
      </div>
    </div>
  </div>

  <canvas id="field" aria-hidden="true"></canvas>

  <div class="ticker cap">
    <span class="live-tab"><i></i>Live</span>
    <div class="ticker-window">
      <div class="track">
        {[0, 1].map((copy) => (
          <ul aria-hidden={copy === 1 ? 'true' : undefined}>
            <li>Edmonton <b class="t-wx">·· °C</b></li>
            <li><b class="t-clock">--:--:--</b> MT</li>
            <li>Last push <b class="t-push">…</b></li>
            <li>Open to <b>software, data &amp; analytics roles</b></li>
            {liveTitles.map((t) => <li>Live now <b>{t}</b></li>)}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    --lights: 0.1s;  /* first bank */
    --step: 0.12s;  /* gap between banks */
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-top: 92px;
    overflow: hidden;
    background:
      radial-gradient(ellipse 46% 60% at 74% 46%, rgba(255, 255, 255, 0.16), transparent 70%),
      var(--cobalt);
    color: var(--n0);
  }

  .pitch, #field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  #field { z-index: 6; }
  .pitch { color: rgba(255, 255, 255, 0.15); }
  .pitch path, .pitch circle:not([fill]) {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  /* ── cold open ───────────────────────────────────────────── */
  .night {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #04061a;
    opacity: 0;
    pointer-events: none;
    animation: night 0.8s linear backwards;
  }
  @keyframes night {
    0%, 18% { opacity: 1; }
    34% { opacity: 0.74; }
    50% { opacity: 0.5; }
    66% { opacity: 0.26; }
    100% { opacity: 0; }
  }

  .tower {
    position: absolute;
    top: 66px;
    z-index: 2;
    width: clamp(84px, 9vw, 132px);
    transform: perspective(300px) rotateX(24deg);
  }
  .tower.t1 { left: 2%; }
  .tower.t2 { left: 15%; width: clamp(60px, 6vw, 92px); }
  .tower.t3 { right: 15%; width: clamp(60px, 6vw, 92px); }
  .tower.t4 { right: 2%; }
  .lamp {
    fill: #fff;
    filter: drop-shadow(0 0 5px #fff) drop-shadow(0 0 12px #cdd3ff);
    animation: lamp-on 0.5s var(--ease) backwards;
  }
  @keyframes lamp-on {
    0% { fill: #2b3043; filter: none; }
    20% { fill: #fff; filter: drop-shadow(0 0 14px #fff) drop-shadow(0 0 40px #fff); }
  }
  .t1 .lamp { animation-delay: var(--lights); }
  .t4 .lamp { animation-delay: calc(var(--lights) + var(--step)); }
  .t2 .lamp { animation-delay: calc(var(--lights) + var(--step) * 2); }
  .t3 .lamp { animation-delay: calc(var(--lights) + var(--step) * 3); }

  .beam {
    position: absolute;
    top: 100px;
    z-index: 2;
    width: 58vw;
    height: 120%;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0) 80%);
    mix-blend-mode: soft-light;
    clip-path: polygon(0 0, 9% 0, 100% 100%, 34% 100%);
    animation: beam-on 0.6s var(--ease) backwards;
  }
  .beam.t1 { left: 4%; }
  .beam.t2 { left: 17%; width: 44vw; opacity: 0.8; }
  .beam.t3 { right: 17%; width: 44vw; opacity: 0.8; transform: scaleX(-1); }
  .beam.t4 { right: 4%; transform: scaleX(-1); }
  .beam.t1 { animation-delay: var(--lights); }
  .beam.t4 { animation-delay: calc(var(--lights) + var(--step)); }
  .beam.t2 { animation-delay: calc(var(--lights) + var(--step) * 2); }
  .beam.t3 { animation-delay: calc(var(--lights) + var(--step) * 3); }
  @keyframes beam-on { 0% { opacity: 0; } 25% { opacity: 1.6; filter: brightness(2); } }

  /* ── layout ─────────────────────────────────────────────── */
  .hero-grid {
    position: relative;
    z-index: 3;
    flex: 1;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: 24px;
    padding-bottom: 40px;
  }

  .name {
    font-size: clamp(3.1rem, 9.4vw, 6rem);
    font-weight: 900;
    font-style: italic;
    font-stretch: 125%;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 0.86;
  }
  .name .word { display: block; padding-right: 0.08em; white-space: nowrap; }
  .name .word + .word { color: var(--volt); }
  .ch {
    display: inline-block;
    font-stretch: 125%;
    transition: font-stretch 0.5s var(--ease), font-weight 0.5s var(--ease);
    animation: squeeze 0.9s var(--ease) calc(1.5s + var(--i) * 45ms) 1;
  }
  @keyframes squeeze { 40% { font-stretch: 64%; font-weight: 500; } }

  .position {
    margin-top: 26px;
    display: inline-block;
    background: var(--n0);
    color: var(--cobalt);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    font-weight: 800;
    padding: 9px 30px 8px 16px;
    clip-path: polygon(0 0, 100% 0, calc(100% - 14px) 100%, 0 100%);
  }
  .lede {
    margin-top: 22px;
    max-width: 50ch;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--cobalt-tint);
  }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }

  /* ── the player card ────────────────────────────────────── */
  .card-stage {
    perspective: 1300px;
    display: grid;
    place-items: center;
    animation: float 7s ease-in-out 2s infinite;
  }
  @keyframes float { 50% { transform: translateY(-10px); } }
  .card {
    --rx: 0deg; --ry: 0deg;
    position: relative;
    width: min(370px, 100%);
    aspect-ratio: 5 / 7;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.6s var(--ease);
    animation: card-in 1s var(--ease) 0.4s backwards;
  }
  @keyframes card-in {
    0% { transform: translateY(120px) rotateY(-200deg) rotateX(20deg) scale(0.6); opacity: 0; }
    25% { opacity: 1; }
  }
  .card-front, .card-back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 30px 100%, 0 calc(100% - 30px));
  }
  .card-back {
    transform: rotateY(180deg);
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(115deg, rgba(255, 255, 255, 0.06) 0 16px, transparent 16px 32px),
      var(--cobalt-deep);
    font-size: 7rem;
    font-weight: 900;
    font-style: italic;
    font-stretch: 112%;
    color: var(--volt);
  }
  .card-front {
    overflow: hidden;
    background:
      repeating-linear-gradient(115deg, rgba(255, 255, 255, 0.025) 0 22px, transparent 22px 44px),
      linear-gradient(165deg, #3348ff 0%, var(--cobalt-deep) 55%, var(--cobalt-night) 100%);
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.22);
  }
  .c-no {
    position: absolute;
    top: 14px;
    left: 20px;
    font-size: 5.6rem;
    font-weight: 900;
    font-style: italic;
    font-stretch: 62%;
    line-height: 0.85;
    color: var(--volt);
  }
  .c-pos {
    position: absolute;
    top: 112px;
    left: 22px;
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--n0);
  }
  .c-city {
    position: absolute;
    top: 22px;
    right: 26px;
    font-size: 0.72rem;
    color: var(--cobalt-tint);
    writing-mode: vertical-rl;
  }
  .c-player {
    position: absolute;
    right: 2%;
    bottom: 104px;
    height: 72%;
    display: flex;
    align-items: flex-end;
  }
  .c-player :global(.mascot) { height: 100%; }
  .c-name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 64px;
    padding: 6px 20px 4px;
    background: var(--n0);
    color: var(--n10);
    font-size: 2.3rem;
    font-weight: 900;
    font-style: italic;
    font-stretch: 118%;
    text-transform: uppercase;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .c-stats {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 64px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--n10);
  }
  .c-stats div {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 14px;
  }
  .c-stats div + div { border-left: 1px solid var(--n8); }
  .c-stats dd {
    font-size: 1.6rem;
    font-weight: 800;
    font-stretch: 70%;
    line-height: 1;
    color: var(--n0);
  }
  .c-stats dt { font-size: 0.62rem; color: var(--n4); margin-top: 3px; }

  /* holo foil + glare follow the light (pointer) */
  .foil, .glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .foil {
    --fx: 50%; --fy: 50%;
    /* two crossed rainbow fields read as iridescence, not stripes */
    background:
      linear-gradient(115deg, transparent 20%, rgba(255, 70, 200, 0.45) 34%, rgba(70, 220, 255, 0.45) 46%,
        rgba(228, 255, 58, 0.45) 58%, rgba(255, 70, 200, 0.35) 70%, transparent 84%),
      radial-gradient(circle at var(--fx) var(--fy), rgba(120, 255, 230, 0.35), transparent 55%);
    background-size: 260% 260%, 100% 100%;
    background-position: var(--fx) var(--fy), 0 0;
    mix-blend-mode: color-dodge;
    opacity: 0.6;
    transition: background-position 0.6s var(--ease);
  }
  .glare {
    --gx: 30%; --gy: 20%;
    background: radial-gradient(circle at var(--gx) var(--gy), rgba(255, 255, 255, 0.5), transparent 46%);
    mix-blend-mode: overlay;
  }
  /* one shine sweep as the card lands */
  .card-front::after {
    content: '';
    position: absolute;
    inset: -20%;
    background: linear-gradient(115deg, transparent 42%, rgba(255, 255, 255, 0.7) 50%, transparent 58%);
    transform: translateX(-100%);
    animation: shine 1.1s var(--ease) 1.3s backwards;
    pointer-events: none;
    opacity: 0;
  }
  @keyframes shine {
    0% { transform: translateX(-100%); opacity: 1; }
    100% { transform: translateX(100%); opacity: 1; }
  }

  /* ── ticker ──────────────────────────────────────────────── */
  .ticker {
    position: relative;
    z-index: 7;
    display: flex;
    height: 50px;
    background: var(--n10);
    font-size: 0.92rem;
    font-weight: 600;
  }
  .live-tab {
    flex: none;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 0 26px 0 var(--gutter);
    background: var(--volt);
    color: var(--n10);
    font-weight: 800;
    clip-path: polygon(0 0, 100% 0, calc(100% - 14px) 100%, 0 100%);
  }
  .live-tab i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--n10);
    animation: pulse 1.4s ease-in-out infinite;
  }
  @keyframes pulse { 50% { opacity: 0.2; } }
  .ticker-window { flex: 1; overflow: hidden; display: flex; align-items: center; }
  .track { display: flex; width: max-content; animation: marquee 48s linear infinite; }
  .ticker:hover .track { animation-play-state: paused; }
  .track ul { display: flex; list-style: none; min-width: 100vw; }
  .track li { white-space: nowrap; padding: 0 22px; color: var(--n4); }
  .track li::after { content: '/'; margin-left: 44px; color: var(--n7); }
  .track b { color: var(--n0); font-weight: 700; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* ── the graphics animate on, after the lights ───────────── */
  @keyframes wipe {
    from { clip-path: inset(-20% 100% -20% 0); }
    to { clip-path: inset(-20% -10% -20% 0); }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(26px); } }
  @keyframes slide { from { opacity: 0; transform: translateX(-30px); } }
  .name .word { animation: wipe 0.7s var(--ease) 0.35s backwards; }
  .name .word + .word { animation-delay: 0.43s; }
  .position { animation: slide 0.6s var(--ease) 0.5s backwards; }
  .lede, .cta-row { animation: rise 0.6s var(--ease) 0.55s backwards; }
  .ticker { animation: rise 0.7s var(--ease) 0.7s backwards; }

  /* repeat visit or deep link: already lit, nothing waits */
  :global(html.lit) .hero :is(.night, .lamp, .beam, .word, .position, .lede, .cta-row, .ticker, .card, .card-front, .ch) {
    animation: none;
  }
  :global(html.lit) .hero .card-front::after { animation: none; }

  /* the card's angled corner never clips the first stat */
  .c-stats div:first-child { padding-left: 30px; }

  @media (max-width: 880px) {
    .hero { padding-top: 72px; }
    .hero-grid { grid-template-columns: 1fr; gap: 34px; padding-bottom: 36px; }
    .position { margin-top: 18px; }
    .lede { margin-top: 16px; font-size: 1rem; }
    .cta-row { margin-top: 20px; }
    .card { width: min(300px, 82vw); }
    .c-no { font-size: 4.4rem; }
    .c-pos { top: 90px; font-size: 0.72rem; }
    .c-name { font-size: 1.8rem; bottom: 56px; }
    .c-stats { height: 56px; }
    .c-player { bottom: 92px; }
    .c-stats dd { font-size: 1.3rem; }
    .c-stats dt { font-size: 0.55rem; }
    .c-stats div { padding: 0 10px; }
    .c-stats div:first-child { padding-left: 30px; }
    .tower { display: none; }
    .beam { top: 0; }
    .tower.t2, .tower.t3, .beam.t2, .beam.t3 { display: none; }
    .beam { width: 90vw; }
  }
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(pointer: fine)').matches;
  const hero = document.getElementById('top')!;
  const canvas = document.getElementById('field') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const t0 = performance.now();

  let W = 0, H = 0, floorY = 0;
  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    W = canvas.offsetWidth;
    H = canvas.offsetHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    floorY = H - 50 - ball.r; // rests on the ticker
    measure();
  }

  // ── pointer (hero coordinates) ──────────────────────────────
  let px = -999, py = -999, pvx = 0, pvy = 0, lastMove = 0;

  // ── snow, brighter where it falls through a floodlight beam ──
  interface Flake { x: number; y: number; r: number; vy: number; vx: number; o: number }
  let flakes: Flake[] = [];
  const spawn = (): Flake => ({
    x: Math.random() * W, y: Math.random() * H,
    r: 0.8 + Math.random() * 2.4, vy: 0.35 + Math.random() * 0.8,
    vx: -0.15 + Math.random() * 0.3, o: 0.3 + Math.random() * 0.5,
  });
  // beams: origin (fraction of W) → aim point (fraction of W at the floor)
  const BEAMS = [[0.08, 0.5], [0.2, 0.62], [0.8, 0.38], [0.92, 0.5]];
  function inBeam(x: number, y: number) {
    let best = 0;
    for (const [ox, ax] of BEAMS) {
      const bx = ox * W, ex = ax * W;
      const along = y / H;
      const cx = bx + (ex - bx) * along;
      const half = 20 + along * W * 0.12;
      best = Math.max(best, 1 - Math.min(1, Math.abs(x - cx) / half));
    }
    return best;
  }

  // ── the ball ─────────────────────────────────────────────────
  const ball = { x: 0, y: -80, vx: 0, vy: 0, r: 22, a: 0, live: false };
  const G = 0.5, REST = 0.7;
  let lastKick = 0;

  // obstacles: the letters of the name and the card
  interface Box { el: HTMLElement; x: number; y: number; w: number; h: number; letter: boolean; hitAt: number }
  let boxes: Box[] = [];
  const letters = [...hero.querySelectorAll<HTMLElement>('.name .ch')];
  const card = document.getElementById('card')!;
  function measure() {
    const hr = hero.getBoundingClientRect();
    const rel = (el: HTMLElement, letter: boolean): Box => {
      const r = el.getBoundingClientRect();
      return { el, x: r.left - hr.left, y: r.top - hr.top + (letter ? r.height * 0.12 : 0), w: r.width, h: letter ? r.height * 0.78 : r.height, letter, hitAt: 0 };
    };
    boxes = [...letters.map((el) => rel(el, true)), rel(card, false)];
  }

  function knock(b: Box, vx: number, vy: number) {
    const now = performance.now();
    if (now - b.hitAt < 400) return;
    b.hitAt = now;
    if (!b.letter) return;
    const s = Math.min(1, Math.hypot(vx, vy) / 18);
    b.el.animate([
      { transform: 'none' },
      { transform: `translate(${vx * 1.6}px, ${vy * 1.6 - 14 * s}px) rotate(${(vx > 0 ? 1 : -1) * (12 + 30 * s)}deg)` },
      { transform: 'none' },
    ], { duration: 900, easing: 'cubic-bezier(0.2, 1.4, 0.4, 1)' });
  }

  function collide() {
    for (const b of boxes) {
      const cx = Math.max(b.x, Math.min(ball.x, b.x + b.w));
      const cy = Math.max(b.y, Math.min(ball.y, b.y + b.h));
      let nx = ball.x - cx, ny = ball.y - cy;
      const d = Math.hypot(nx, ny);
      if (d >= ball.r) continue;
      if (d === 0) { nx = 0; ny = -1; } else { nx /= d; ny /= d; }
      ball.x = cx + nx * ball.r;
      ball.y = cy + ny * ball.r;
      const dot = ball.vx * nx + ball.vy * ny;
      if (dot < 0) {
        ball.vx -= (1 + REST) * dot * nx;
        ball.vy -= (1 + REST) * dot * ny;
        if (Math.abs(dot) > 3) knock(b, ball.vx * 0.6, ball.vy * 0.6);
      }
    }
  }

  function kickFrom(x: number, y: number, power: number) {
    const now = performance.now();
    if (now - lastKick < 140) return;
    lastKick = now;
    let nx = ball.x - x, ny = ball.y - y;
    const d = Math.hypot(nx, ny) || 1;
    nx /= d; ny /= d;
    ball.vx = nx * power + pvx * 0.5;
    ball.vy = ny * power + pvy * 0.5 - 7;
    dispatchEvent(new CustomEvent('ss:kick'));
  }

  function step() {
    ball.vy += G;
    ball.vx *= 0.996;
    ball.x += ball.vx;
    ball.y += ball.vy;
    if (ball.y > floorY) {
      ball.y = floorY;
      ball.vy = Math.abs(ball.vy) < 1.6 ? 0 : -ball.vy * REST;
      ball.vx *= 0.95;
    }
    if (ball.x < ball.r) { ball.x = ball.r; ball.vx = Math.abs(ball.vx) * REST; }
    if (ball.x > W - ball.r) { ball.x = W - ball.r; ball.vx = -Math.abs(ball.vx) * REST; }
    if (ball.y < -400) { ball.y = -400; ball.vy = 0; }
    collide();
    ball.a += ball.vx / ball.r;
    // the pointer kicks it on contact
    if (fine && performance.now() - lastMove < 80 && Math.hypot(ball.x - px, ball.y - py) < ball.r + 12) {
      kickFrom(px, py, 9);
    }
  }

  function drawBall() {
    const { x, y, r, a } = ball;
    // floor shadow shrinks as the ball rises
    const lift = Math.max(0, Math.min(1, (floorY - y) / 320));
    ctx.fillStyle = `rgba(4, 6, 26, ${0.35 * (1 - lift)})`;
    ctx.beginPath();
    ctx.ellipse(x, floorY + r - 2, r * (1 - lift * 0.5), r * 0.25 * (1 - lift * 0.5), 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(a);
    ctx.fillStyle = '#fff';
    ctx.beginPath(); ctx.arc(0, 0, r, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = '#0a0c16';
    const pent = (cx: number, cy: number, s: number, rot: number) => {
      ctx.beginPath();
      for (let i = 0; i < 5; i++) {
        const t = rot + (i * 2 * Math.PI) / 5;
        ctx.lineTo(cx + Math.cos(t) * s, cy + Math.sin(t) * s);
      }
      ctx.closePath();
      ctx.fill();
    };
    pent(0, 0, r * 0.36, -Math.PI / 2);
    ctx.save();
    ctx.beginPath(); ctx.arc(0, 0, r, 0, Math.PI * 2); ctx.clip();
    for (let i = 0; i < 5; i++) {
      const t = -Math.PI / 2 + (i * 2 * Math.PI) / 5 + Math.PI / 5;
      pent(Math.cos(t) * r * 0.98, Math.sin(t) * r * 0.98, r * 0.34, t);
    }
    ctx.restore();
    ctx.strokeStyle = '#0a0c16';
    ctx.lineWidth = 1.6;
    ctx.beginPath(); ctx.arc(0, 0, r - 0.8, 0, Math.PI * 2); ctx.stroke();
    // a little shading so it reads round
    const g = ctx.createRadialGradient(-r * 0.35, -r * 0.4, r * 0.1, 0, 0, r);
    g.addColorStop(0, 'rgba(255,255,255,0)');
    g.addColorStop(1, 'rgba(10,12,40,0.28)');
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(0, 0, r, 0, Math.PI * 2); ctx.fill();
    ctx.restore();
  }

  let visible = true;
  function tick() {
    if (!visible || document.hidden) return;
    ctx.clearRect(0, 0, W, H);
    const lit = Math.max(0, Math.min(1, (performance.now() - t0 - 300) / 1100));
    const time = performance.now() / 3000;
    ctx.fillStyle = '#fff';
    for (const f of flakes) {
      f.y += f.vy;
      f.x += f.vx + Math.sin(time + f.y / 60) * 0.18;
      const dx = f.x - px, dy = f.y - py, d2 = dx * dx + dy * dy;
      if (d2 < 9000) { const k = ((9000 - d2) / 9000) * 2.4, d = Math.sqrt(d2) || 1; f.x += (dx / d) * k; f.y += (dy / d) * k; }
      if (f.y > H + 4) { f.y = -4; f.x = Math.random() * W; }
      const glow = inBeam(f.x, f.y) * lit;
      ctx.globalAlpha = Math.min(1, f.o * (0.35 + 0.65 * lit) + glow * 0.5);
      ctx.beginPath();
      ctx.arc(f.x, f.y, f.r * (1 + glow * 0.5), 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
    if (ball.live) { step(); drawBall(); }
    requestAnimationFrame(tick);
  }

  if (!reduced) {
    ball.r = innerWidth < 880 ? 17 : 22;
    resize();
    flakes = Array.from({ length: Math.min(130, Math.floor(W / 10)) }, spawn);
    addEventListener('resize', resize);
    // letters change width (kinetic type) and the card floats: re-measure often
    setInterval(measure, 300);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) requestAnimationFrame(tick);
    }).observe(hero);
    document.addEventListener('visibilitychange', () => { if (!document.hidden && visible) requestAnimationFrame(tick); });
    requestAnimationFrame(tick);
    // the ball drops in once the lights are up
    setTimeout(() => {
      measure();
      Object.assign(ball, { x: W * (W > 880 ? 0.56 : 0.78), y: -60, vx: W > 880 ? -3.5 : -1.5, vy: 2, live: true });
    }, document.documentElement.classList.contains('lit') ? 300 : 1300);
  }

  // ── pointer: kick, tilt the card, push the snow, bend the name ──
  const foil = card.querySelector<HTMLElement>('.foil')!;
  const glare = card.querySelector<HTMLElement>('.glare')!;
  let queued = false, mx = -999, my = -999;
  function frame() {
    queued = false;
    // kinetic name: letters near the cursor squeeze and thin out
    for (const el of letters) {
      const r = el.getBoundingClientRect();
      const k = Math.max(0, 1 - Math.hypot(r.left + r.width / 2 - mx, r.top + r.height / 2 - my) / 260);
      el.style.fontStretch = `${125 - 61 * k}%`;
      el.style.fontWeight = String(Math.round(900 - 560 * k));
    }
    // card tilts toward the light
    const cr = card.getBoundingClientRect();
    const rx = Math.max(-1, Math.min(1, (mx - (cr.left + cr.width / 2)) / (innerWidth / 2)));
    const ry = Math.max(-1, Math.min(1, (my - (cr.top + cr.height / 2)) / (innerHeight / 2)));
    card.style.setProperty('--ry', `${rx * 18}deg`);
    card.style.setProperty('--rx', `${-ry * 12}deg`);
    foil.style.setProperty('--fx', `${50 + rx * 40}%`);
    foil.style.setProperty('--fy', `${50 + ry * 40}%`);
    glare.style.setProperty('--gx', `${((mx - cr.left) / cr.width) * 100}%`);
    glare.style.setProperty('--gy', `${((my - cr.top) / cr.height) * 100}%`);
  }

  if (!reduced) {
    hero.addEventListener('pointermove', (e) => {
      const hr = hero.getBoundingClientRect();
      const nx = e.clientX - hr.left, ny = e.clientY - hr.top, now = performance.now();
      const dt = Math.max(8, now - lastMove);
      pvx = Math.max(-30, Math.min(30, ((nx - px) / dt) * 16));
      pvy = Math.max(-30, Math.min(30, ((ny - py) / dt) * 16));
      px = nx; py = ny; lastMove = now;
      mx = e.clientX; my = e.clientY;
      // tell the cursor when a kick is on
      document.documentElement.toggleAttribute('data-near-ball', ball.live && Math.hypot(ball.x - px, ball.y - py) < ball.r + 70);
      if (fine && !queued) { queued = true; requestAnimationFrame(frame); }
    });
    hero.addEventListener('pointerleave', () => {
      px = py = mx = my = -999;
      document.documentElement.removeAttribute('data-near-ball');
      letters.forEach((el) => { el.style.fontStretch = ''; el.style.fontWeight = ''; });
      card.style.setProperty('--rx', '0deg');
      card.style.setProperty('--ry', '0deg');
    });
    // tap / click near the ball punts it
    hero.addEventListener('pointerdown', (e) => {
      if (!ball.live) return;
      const hr = hero.getBoundingClientRect();
      const x = e.clientX - hr.left, y = e.clientY - hr.top;
      if (Math.hypot(ball.x - x, ball.y - y) < ball.r + 40) {
        lastKick = 0;
        pvx = (ball.x - x) * 0.4; pvy = -10;
        kickFrom(x, y + ball.r, 14);
      }
    });
  }

  // ── live Edmonton weather (Open-Meteo, no key) ───────────────
  const setAll = (cls: string, text: string) =>
    document.querySelectorAll(cls).forEach((el) => { el.textContent = text; });
  const WMO: Record<number, string> = {
    0: 'clear', 1: 'mostly clear', 2: 'partly cloudy', 3: 'overcast',
    45: 'fog', 48: 'fog', 51: 'drizzle', 61: 'rain', 63: 'rain', 65: 'rain',
    71: 'snow', 73: 'snow', 75: 'snow', 77: 'snow', 80: 'showers',
    85: 'snow showers', 86: 'snow showers', 95: 'thunderstorm',
  };
  fetch('https://api.open-meteo.com/v1/forecast?latitude=53.55&longitude=-113.49&current_weather=true')
    .then((r) => r.json())
    .then((d) => {
      const cw = d.current_weather;
      const desc = WMO[cw.weathercode] ?? '';
      setAll('.t-wx', `${Math.round(cw.temperature)}°C${desc ? ', ' + desc : ''}`);
    })
    .catch(() => setAll('.t-wx', 'probably cold'));

  // ── local clock (Mountain Time) ──────────────────────────────
  const fmt = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/Edmonton', hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit',
  });
  const tickClock = () => setAll('.t-clock', fmt.format(new Date()));
  tickClock();
  setInterval(tickClock, 1000);
</script>
