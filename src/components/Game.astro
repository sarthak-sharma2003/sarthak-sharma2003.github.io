---
// Halftime: a 5-shot penalty shootout. Click (or tap) where to shoot.
// Taker: a certain #10 in yellow. Keeper difficulty is selectable.
---

<section id="halftime">
  <div class="container">
    <div class="section-head reveal">
      <span class="index">05</span>
      <h2>Halftime</h2>
      <span class="rule"></span>
    </div>
    <p class="section-sub reveal">
      You've scrolled this far — you've earned a break. Five penalties,
      one questionable keeper. Click where you want to shoot.
    </p>

    <div class="pitch-wrap reveal">
      <div class="diff-row mono">
        <span class="diff-label">keeper:</span>
        <button class="diff-btn" data-diff="0" type="button">sunday league</button>
        <button class="diff-btn" data-diff="1" type="button">pro</button>
        <button class="diff-btn" data-diff="2" type="button">world cup final</button>
      </div>
      <div class="pitch-frame">
        <canvas id="pitch" width="640" height="420"></canvas>
        <div id="trophy-pop" class="trophy-pop" hidden aria-hidden="true">
          <svg viewBox="0 0 80 104">
            <defs>
              <linearGradient id="gold" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#ffe08a"/>
                <stop offset="55%" stop-color="#ffd54a"/>
                <stop offset="100%" stop-color="#c9962b"/>
              </linearGradient>
            </defs>
            <!-- globe -->
            <circle cx="40" cy="18" r="13" fill="url(#gold)"/>
            <path d="M27 18 h26 M40 5 v26" stroke="#e9c34f" stroke-width="1" fill="none" opacity="0.7"/>
            <!-- arms holding the globe -->
            <path d="M29 74 C24 58 22 46 26 38 C29 32 33 29 36 30 C33 36 32 44 34 52 C36 62 38 68 39 74 Z" fill="url(#gold)"/>
            <path d="M51 74 C56 58 58 46 54 38 C51 32 47 29 44 30 C47 36 48 44 46 52 C44 62 42 68 41 74 Z" fill="url(#gold)"/>
            <path d="M33 74 q7 -4 14 0 l1 6 h-16 Z" fill="url(#gold)"/>
            <!-- base with green bands -->
            <rect x="22" y="80" width="36" height="16" rx="5" fill="url(#gold)"/>
            <rect x="22" y="84" width="36" height="3.2" fill="#1d7a4f"/>
            <rect x="22" y="90" width="36" height="3.2" fill="#1d7a4f"/>
          </svg>
          <span class="trophy-label mono">trophy round</span>
        </div>
      </div>
      <div class="scoreline mono">
        <span>goals <span id="g-goals" class="tel-val">0</span>/<span id="g-shots">0</span></span>
        <button id="g-reset" class="btn" type="button">new round</button>
      </div>
    </div>
  </div>
</section>

<style>
  .pitch-wrap {
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pitch-frame { position: relative; }
  .trophy-pop[hidden] { display: none; }
  .trophy-pop {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    pointer-events: none;
    z-index: 5;
    background: radial-gradient(ellipse 45% 45% at 50% 48%, rgba(8, 16, 32, 0.85), transparent);
  }
  .trophy-pop svg {
    width: 108px;
    filter: drop-shadow(0 0 26px rgba(255, 213, 74, 0.5));
    animation: trophy-in 0.65s cubic-bezier(0.2, 1.7, 0.4, 1);
  }
  .trophy-label {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #ffd54a;
    animation: trophy-in 0.65s cubic-bezier(0.2, 1.7, 0.4, 1);
  }
  .trophy-pop.leaving { animation: trophy-out 0.45s ease forwards; }
  @keyframes trophy-in {
    0% { transform: scale(0) rotate(-14deg); opacity: 0; }
    100% { transform: scale(1) rotate(0deg); opacity: 1; }
  }
  @keyframes trophy-out {
    to { opacity: 0; transform: translateY(-14px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .trophy-pop svg, .trophy-label { animation: none; }
  }

  #pitch {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: radial-gradient(ellipse 90% 70% at 50% 0%, #0d1b2e, #081020);
    cursor: crosshair;
    touch-action: manipulation;
  }
  .diff-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }
  .diff-label { color: var(--faint); }
  .diff-btn {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 99px;
    padding: 4px 11px;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .diff-btn:hover { border-color: var(--border-bright); color: var(--text); }
  .diff-btn.active {
    color: var(--aurora);
    border-color: rgba(74, 222, 128, 0.4);
    background: rgba(74, 222, 128, 0.07);
  }
  .scoreline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--muted);
    letter-spacing: 0.06em;
  }
  .tel-val { color: var(--aurora); }
</style>

<script>
  const cv = document.getElementById('pitch') as HTMLCanvasElement;
  const c = cv.getContext('2d')!;
  const W = cv.width, H = cv.height;

  // goal geometry
  const GOAL = { x: 120, y: 60, w: 400, h: 150 };
  const BALL_START = { x: W / 2 + 10, y: H - 52 };
  const SHOTS_PER_ROUND = 5;

  // keeper difficulty: chance he reads your column / row
  const DIFFS = [
    { name: 'sunday league', mind: 0.25, row: 0.5 },
    { name: 'pro', mind: 0.45, row: 0.5 },
    { name: 'world cup final', mind: 0.75, row: 0.65 },
  ];
  let diff = Math.min(2, Math.max(0, Number(localStorage.getItem('keeper-diff') ?? 1) || 0));

  type Phase = 'ready' | 'anim' | 'over';
  type KickPose = 'idle' | 'wind' | 'through';
  let phase: Phase = 'ready';
  let goals = 0, shots = 0;
  let msg = 'click the goal to shoot';
  let msgColor = '#8ba0bd';
  let kickPose: KickPose = 'idle';

  // keeper occupies one of 6 zones: 3 columns × 2 rows
  const colW = GOAL.w / 3, rowH = GOAL.h / 2;

  const goalsEl = document.getElementById('g-goals')!;
  const shotsEl = document.getElementById('g-shots')!;
  const diffBtns = [...document.querySelectorAll<HTMLButtonElement>('.diff-btn')];

  function zoneCenter(col: number, row: number) {
    return {
      x: GOAL.x + colW * col + colW / 2,
      y: GOAL.y + rowH * row + rowH / 2,
    };
  }

  function drawKeeper(x: number, y: number, diving: boolean) {
    c.save();
    c.translate(x, y);
    if (diving) c.rotate(x < W / 2 ? -0.5 : x > W / 2 ? 0.5 : 0);
    // body
    c.fillStyle = '#fbbf24';
    c.beginPath();
    c.roundRect(-11, -18, 22, 40, 8);
    c.fill();
    // head
    c.fillStyle = '#e8c39e';
    c.beginPath();
    c.arc(0, -28, 9, 0, Math.PI * 2);
    c.fill();
    // arms out
    c.strokeStyle = '#fbbf24';
    c.lineWidth = 6;
    c.lineCap = 'round';
    c.beginPath();
    c.moveTo(-10, -12); c.lineTo(-26, diving ? -26 : -2);
    c.moveTo(10, -12); c.lineTo(26, diving ? -26 : -2);
    c.stroke();
    c.restore();
  }

  // the taker — a certain #10, seen from behind
  function drawKicker(pose: KickPose) {
    const bx = BALL_START.x - 46; // body center x
    const footY = H - 34;         // ground line for feet
    const hipY = footY - 26;
    const torsoTop = hipY - 34;

    c.save();
    c.lineCap = 'round';

    // standing leg (left)
    c.strokeStyle = '#e8c39e';
    c.lineWidth = 7;
    c.beginPath();
    c.moveTo(bx - 6, hipY);
    c.lineTo(bx - 8, footY - 8);
    c.stroke();
    // sock + boot
    c.strokeStyle = '#eef4fb';
    c.beginPath(); c.moveTo(bx - 8, footY - 12); c.lineTo(bx - 8, footY - 4); c.stroke();
    c.fillStyle = '#0b1322';
    c.beginPath(); c.roundRect(bx - 14, footY - 5, 13, 6, 3); c.fill();

    // kicking leg (right) — pose dependent
    let kneeX = bx + 8, kneeY = hipY + 12, toeX = bx + 10, toeY = footY - 2;
    if (pose === 'wind') { kneeX = bx - 2; kneeY = hipY + 8; toeX = bx - 16; toeY = footY - 14; }
    if (pose === 'through') { kneeX = bx + 16; kneeY = hipY + 4; toeX = bx + 34; toeY = footY - 26; }
    c.strokeStyle = '#e8c39e';
    c.lineWidth = 7;
    c.beginPath();
    c.moveTo(bx + 6, hipY);
    c.quadraticCurveTo(kneeX, kneeY, toeX, toeY);
    c.stroke();
    // sock on the kicking foot
    c.strokeStyle = '#eef4fb';
    c.lineWidth = 7;
    c.beginPath();
    c.moveTo((kneeX + toeX) / 2, (kneeY + toeY) / 2);
    c.lineTo(toeX, toeY);
    c.stroke();
    c.fillStyle = '#0b1322';
    c.beginPath(); c.arc(toeX + 3, toeY, 4.5, 0, Math.PI * 2); c.fill();

    // shorts
    c.fillStyle = '#2456d6';
    c.beginPath(); c.roundRect(bx - 12, hipY - 12, 24, 15, 4); c.fill();

    // torso (leans into the strike)
    const lean = pose === 'through' ? 4 : pose === 'wind' ? -3 : 0;
    c.fillStyle = '#ffdc2e';
    c.beginPath(); c.roundRect(bx - 13 + lean, torsoTop, 26, 26, 7); c.fill();
    // green collar
    c.fillStyle = '#159347';
    c.beginPath(); c.roundRect(bx - 6 + lean, torsoTop - 1, 12, 4, 2); c.fill();

    // arms (balance pose)
    c.strokeStyle = '#ffdc2e';
    c.lineWidth = 6;
    c.beginPath();
    c.moveTo(bx - 11 + lean, torsoTop + 7); c.lineTo(bx - 24 + lean, torsoTop + (pose === 'idle' ? 20 : 2));
    c.moveTo(bx + 11 + lean, torsoTop + 7); c.lineTo(bx + 24 + lean, torsoTop + (pose === 'idle' ? 20 : 10));
    c.stroke();

    // shirt print
    c.fillStyle = '#159347';
    c.textAlign = 'center';
    c.font = '600 6px "JetBrains Mono", monospace';
    c.fillText('NEYMAR JR', bx + lean, torsoTop + 9);
    c.font = '700 14px "JetBrains Mono", monospace';
    c.fillText('10', bx + lean, torsoTop + 22);

    // head + hair
    c.fillStyle = '#e8c39e';
    c.beginPath(); c.arc(bx + lean, torsoTop - 8, 7.5, 0, Math.PI * 2); c.fill();
    c.fillStyle = '#1a1410';
    c.beginPath(); c.arc(bx + lean, torsoTop - 10, 7.5, Math.PI * 0.95, Math.PI * 2.05); c.fill();
    c.beginPath(); c.roundRect(bx + lean - 4, torsoTop - 20, 8, 5, 2); c.fill();

    c.restore();
  }

  function drawBall(x: number, y: number, r: number) {
    c.fillStyle = '#eef4fb';
    c.beginPath();
    c.arc(x, y, r, 0, Math.PI * 2);
    c.fill();
    c.strokeStyle = '#0a1120';
    c.lineWidth = 1.4;
    c.stroke();
    // simple pentagon patch
    c.fillStyle = '#0a1120';
    c.beginPath();
    c.arc(x - r * 0.25, y - r * 0.2, r * 0.32, 0, Math.PI * 2);
    c.fill();
  }

  function drawScene(ball: { x: number; y: number; r: number }, keeperPos: { x: number; y: number }, diving: boolean) {
    c.clearRect(0, 0, W, H);

    // pitch lines
    c.strokeStyle = 'rgba(110, 203, 255, 0.14)';
    c.lineWidth = 2;
    c.strokeRect(60, GOAL.y + GOAL.h + 8, W - 120, H - GOAL.y - GOAL.h - 60);
    c.beginPath();
    c.arc(W / 2, H - 50, 34, Math.PI, 0);
    c.stroke();

    // net
    c.strokeStyle = 'rgba(220, 231, 245, 0.10)';
    c.lineWidth = 1;
    for (let i = 0; i <= 10; i++) {
      const nx = GOAL.x + (GOAL.w / 10) * i;
      c.beginPath(); c.moveTo(nx, GOAL.y); c.lineTo(nx, GOAL.y + GOAL.h); c.stroke();
    }
    for (let i = 0; i <= 4; i++) {
      const ny = GOAL.y + (GOAL.h / 4) * i;
      c.beginPath(); c.moveTo(GOAL.x, ny); c.lineTo(GOAL.x + GOAL.w, ny); c.stroke();
    }

    // posts
    c.strokeStyle = '#dce7f5';
    c.lineWidth = 5;
    c.lineCap = 'round';
    c.beginPath();
    c.moveTo(GOAL.x, GOAL.y + GOAL.h);
    c.lineTo(GOAL.x, GOAL.y);
    c.lineTo(GOAL.x + GOAL.w, GOAL.y);
    c.lineTo(GOAL.x + GOAL.w, GOAL.y + GOAL.h);
    c.stroke();

    drawKeeper(keeperPos.x, keeperPos.y, diving);
    drawKicker(kickPose);
    drawBall(ball.x, ball.y, ball.r);

    // message
    c.fillStyle = msgColor;
    c.font = '600 15px "JetBrains Mono", monospace';
    c.textAlign = 'center';
    c.fillText(msg, W / 2, H - 12);
  }

  function updateScore() {
    goalsEl.textContent = String(goals);
    shotsEl.textContent = String(shots);
  }

  // 3+ goals in a round earns the trophy
  const trophyEl = document.getElementById('trophy-pop')!;
  let trophyTimer = 0;
  function showTrophy() {
    clearTimeout(trophyTimer);
    trophyEl.classList.remove('leaving');
    trophyEl.hidden = false;
    trophyTimer = window.setTimeout(() => {
      trophyEl.classList.add('leaving');
      trophyTimer = window.setTimeout(() => { trophyEl.hidden = true; }, 450);
    }, 2400);
  }

  function paintDiff() {
    diffBtns.forEach((b) => b.classList.toggle('active', Number(b.dataset.diff) === diff));
  }

  function reset() {
    goals = 0; shots = 0;
    phase = 'ready';
    kickPose = 'idle';
    clearTimeout(trophyTimer);
    trophyEl.classList.remove('leaving');
    trophyEl.hidden = true;
    msg = `click the goal to shoot · keeper: ${DIFFS[diff]!.name}`;
    msgColor = '#8ba0bd';
    updateScore();
    drawScene({ ...BALL_START, r: 11 }, zoneCenter(1, 1), false);
  }

  function shoot(tx: number, ty: number) {
    if (phase !== 'ready') return;
    phase = 'anim';

    const onTarget =
      tx > GOAL.x && tx < GOAL.x + GOAL.w && ty > GOAL.y && ty < GOAL.y + GOAL.h;

    // keeper picks a zone — difficulty sets how often he reads your mind
    const { mind, row } = DIFFS[diff]!;
    const shotCol = Math.max(0, Math.min(2, Math.floor((tx - GOAL.x) / colW)));
    const shotRow = ty < GOAL.y + rowH ? 0 : 1;
    const kCol = Math.random() < mind ? shotCol : Math.floor(Math.random() * 3);
    const kRow = Math.random() < row ? shotRow : 1 - shotRow;
    const saved = onTarget && kCol === shotCol && kRow === shotRow;
    const kTarget = zoneCenter(kCol, kRow);
    const kStart = zoneCenter(1, 1);

    const t0 = performance.now();
    const DUR = 480;

    function frame(now: number) {
      const t = Math.min(1, (now - t0) / DUR);
      kickPose = t < 0.16 ? 'wind' : 'through';
      const ease = 1 - Math.pow(1 - t, 3);
      const bx = BALL_START.x + (tx - BALL_START.x) * ease;
      const by = BALL_START.y + (ty - BALL_START.y) * ease - Math.sin(t * Math.PI) * 26;
      const br = 11 - 5 * ease;
      const kx = kStart.x + (kTarget.x - kStart.x) * ease;
      const ky = kStart.y + (kTarget.y - kStart.y) * ease;
      drawScene({ x: bx, y: by, r: br }, { x: kx, y: ky }, t > 0.15);
      if (t < 1) { requestAnimationFrame(frame); return; }

      // resolve
      shots++;
      if (!onTarget) { msg = 'wide! row Z of the stands'; msgColor = '#8ba0bd'; }
      else if (saved) { msg = 'SAVED — he read you like a csv'; msgColor = '#fbbf24'; }
      else { goals++; msg = 'GOAL! top bins'; msgColor = '#4ade80'; }
      updateScore();

      if (shots >= SHOTS_PER_ROUND) {
        phase = 'over';
        const verdict = goals === 5 ? 'perfect — sign him up' : goals >= 3 ? 'solid conversion rate' : 'the keeper wins this one';
        msg = `round over: ${goals}/${SHOTS_PER_ROUND} — ${verdict}`;
        kickPose = 'idle';
        drawScene({ ...BALL_START, r: 11 }, { x: kTarget.x, y: kTarget.y }, false);
        if (goals >= 3) showTrophy();
      } else {
        setTimeout(() => {
          if (phase !== 'over') {
            phase = 'ready';
            kickPose = 'idle';
            drawScene({ ...BALL_START, r: 11 }, zoneCenter(1, 1), false);
          }
        }, 900);
        drawScene({ x: tx, y: ty, r: 6 }, { x: kTarget.x, y: kTarget.y }, true);
      }
    }
    requestAnimationFrame(frame);
  }

  cv.addEventListener('pointerdown', (e) => {
    const rect = cv.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * W;
    const y = ((e.clientY - rect.top) / rect.height) * H;
    shoot(x, y);
  });

  diffBtns.forEach((b) =>
    b.addEventListener('click', () => {
      diff = Number(b.dataset.diff);
      localStorage.setItem('keeper-diff', String(diff));
      paintDiff();
      reset();
    })
  );

  document.getElementById('g-reset')!.addEventListener('click', reset);
  paintDiff();
  reset();
</script>
