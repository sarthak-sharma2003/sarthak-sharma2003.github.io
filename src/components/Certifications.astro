---
import { certs } from '../data/certs';
import Icon from './Icon.astro';
---

<section id="certs" class="sec certs">
  <div class="wrap">
    <div class="sec-head">
      <h2>Certifications</h2>
    </div>

    <ol class="honours">
      {certs.map((cert) => (
        <li>
          <span class="year">{cert.year}</span>
          <h3>{cert.title}</h3>
          <p class="issuer cap">
            {cert.issuer}
            {cert.verifyUrl ? (
              <a class="verify" href={cert.verifyUrl} target="_blank" rel="noopener">
                Verify{cert.credentialId && ` · ${cert.credentialId}`}<Icon name="out" />
              </a>
            ) : cert.credentialId ? (
              <span class="verify">ID {cert.credentialId}</span>
            ) : null}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .certs { padding-top: 0; }
  .honours { list-style: none; border-top: 2px solid var(--n10); }
  li {
    display: grid;
    grid-template-columns: 116px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 6px clamp(20px, 3vw, 44px);
    padding: 22px 0;
    border-bottom: 1px solid var(--n3);
  }
  .year {
    font-size: 2.6rem;
    font-weight: 900;
    font-style: italic;
    font-stretch: 62%;
    line-height: 1;
    color: var(--cobalt);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }
  h3 {
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 800;
    font-stretch: 88%;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .issuer {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px 18px;
    font-size: 0.85rem;
    color: var(--n6);
    text-align: right;
  }
  .verify {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--cobalt);
    text-decoration: none;
  }
  @media (max-width: 720px) {
    li { grid-template-columns: 64px minmax(0, 1fr); }
    .year { font-size: 1.9rem; text-align: left; }
    .issuer { grid-column: 2; justify-content: flex-start; text-align: left; }
  }
</style>
