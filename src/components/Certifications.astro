---
import { certs } from '../data/certs';
import Icon from './Icon.astro';
---

<section id="certs" class="sec certs">
  <div class="wrap">
    <div class="sec-head">
      <h2>Certifications</h2>
    </div>

    <ul class="honours">
      {certs.map((cert) => (
        <li>
          <span class="year cap">{cert.year}</span>
          <div>
            <h3>{cert.title}</h3>
            <p class="issuer cap">{cert.issuer}</p>
          </div>
          {cert.verifyUrl ? (
            <a class="verify cap" href={cert.verifyUrl} target="_blank" rel="noopener">
              Verify{cert.credentialId && ` · ${cert.credentialId}`}<Icon name="out" />
            </a>
          ) : cert.credentialId ? (
            <span class="verify cap">ID {cert.credentialId}</span>
          ) : null}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .certs { padding-top: 0; }
  .honours {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--n0);
    padding: 22px 24px 24px;
    border-top: 4px solid var(--n10);
  }
  .year {
    align-self: flex-start;
    background: var(--n10);
    color: var(--volt);
    font-size: 0.82rem;
    padding: 4px 14px 3px 8px;
    clip-path: polygon(0 0, 100% 0, calc(100% - 7px) 100%, 0 100%);
  }
  h3 {
    font-size: 1.2rem;
    font-weight: 800;
    font-stretch: 90%;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .issuer { margin-top: 8px; font-size: 0.82rem; color: var(--n6); }
  .verify {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    color: var(--cobalt);
    text-decoration: none;
  }
  @media (max-width: 860px) {
    .honours { grid-template-columns: 1fr; }
  }
</style>
