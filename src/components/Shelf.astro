---
import { projects } from '../data/projects';

const badgeLabel: Record<string, string> = {
  live: 'live',
  shipped: 'shipped',
  building: 'in progress',
  next: 'up next',
};
---

<section id="projects">
  <div class="container">
    <div class="section-head reveal">
      <span class="index">01</span>
      <h2>The Shelf</h2>
      <span class="rule"></span>
    </div>
    <p class="section-sub reveal">
      Projects, past and future. Live stats pulled straight from the GitHub API —
      because a portfolio about data pipelines should probably have one.
    </p>

    <div class="shelf-grid">
      {projects.map((p) => (
        <article class={`card reveal ${p.status === 'next' ? 'card-ghost' : ''}`}>
          <div class="card-top">
            <span class={`badge badge-${p.status}`}>
              <span class="dot"></span>{badgeLabel[p.status]}
            </span>
            <span class="card-year">{p.year}</span>
          </div>
          <h3 class="card-title">{p.title}</h3>
          <p>{p.description}</p>
          {p.tags.length > 0 && (
            <div class="tags">
              {p.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          )}
          {(p.repo || p.demo) && (
            <div class="card-foot">
              <div class="card-links">
                {p.repo && (
                  <a href={`https://github.com/sarthak-sharma2003/${p.repo}`} target="_blank" rel="noopener">code ↗</a>
                )}
                {p.demo && <a href={p.demo} target="_blank" rel="noopener">live app ↗</a>}
              </div>
              {p.repo && <span class="gh-stat" data-repo={p.repo}></span>}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Enrich cards (and the hero telemetry bar) with live GitHub data.
  // Cached in sessionStorage to stay friendly to the unauthenticated rate limit.
  interface Repo { name: string; pushed_at: string; language: string | null }

  function relTime(iso: string): string {
    const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86400000);
    if (days <= 0) return 'today';
    if (days === 1) return 'yesterday';
    if (days < 30) return `${days}d ago`;
    if (days < 365) return `${Math.floor(days / 30)}mo ago`;
    return `${Math.floor(days / 365)}y ago`;
  }

  async function getRepos(): Promise<Repo[]> {
    const cached = sessionStorage.getItem('gh-repos');
    if (cached) return JSON.parse(cached);
    const res = await fetch('https://api.github.com/users/sarthak-sharma2003/repos?per_page=100');
    if (!res.ok) throw new Error(`GitHub API ${res.status}`);
    const repos: Repo[] = (await res.json()).map((r: any) => ({
      name: r.name, pushed_at: r.pushed_at, language: r.language,
    }));
    sessionStorage.setItem('gh-repos', JSON.stringify(repos));
    return repos;
  }

  getRepos()
    .then((repos) => {
      const byName = new Map(repos.map((r) => [r.name.toLowerCase(), r]));
      document.querySelectorAll<HTMLElement>('.gh-stat[data-repo]').forEach((el) => {
        const r = byName.get(el.dataset.repo!.toLowerCase());
        if (r) el.textContent = `pushed ${relTime(r.pushed_at)}${r.language ? ' · ' + r.language : ''}`;
      });
      const latest = repos.reduce((a, b) => (a.pushed_at > b.pushed_at ? a : b));
      const heroEl = document.getElementById('last-commit');
      if (heroEl) heroEl.textContent = relTime(latest.pushed_at);
    })
    .catch(() => {
      const heroEl = document.getElementById('last-commit');
      if (heroEl) heroEl.textContent = 'recently';
    });
</script>
