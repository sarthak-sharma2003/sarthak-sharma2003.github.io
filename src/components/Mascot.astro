---
// Cartoon Sarthak — waves hello for the first few seconds, then chills.
// Lives in the hero, bottom-left, opposite the igloo.
// The left arm exists ONLY inside .wave-arm — the jacket body has no
// sleeve-like flaps, so raising the arm never leaves a ghost limb behind.
---

<svg class="mascot" viewBox="0 0 120 230" aria-hidden="true">
  <!-- waving arm (the one and only left arm) -->
  <g class="wave-arm">
    <path d="M40 94 q-9 20 -7 42" stroke="#d64545" stroke-width="12" fill="none" stroke-linecap="round"/>
    <circle cx="33" cy="140" r="7" fill="#c68a5a"/>
  </g>

  <!-- legs: black wide-leg pants -->
  <path d="M44 143 h14 l-2 62 h-16 Z" fill="#17181c"/>
  <path d="M62 143 h14 l4 62 h-16 Z" fill="#17181c"/>
  <!-- white sneakers -->
  <rect x="36" y="203" width="24" height="11" rx="5" fill="#ffffff"/>
  <rect x="64" y="203" width="24" height="11" rx="5" fill="#ffffff"/>
  <path d="M37 210 h22 M65 210 h22" stroke="#c3cbd8" stroke-width="1.8"/>

  <!-- torso: one clean red bomber shape -->
  <path d="M38 84 Q60 74 82 84 L87 140 Q60 149 33 140 Z" fill="#d64545"/>
  <!-- black tee through the open zipper -->
  <path d="M53 80 L60 87 L67 80 L69 142 Q60 145 51 142 Z" fill="#17181c"/>
  <path d="M60 87 V143" stroke="#c3cbd8" stroke-width="1.5"/>
  <!-- collar + hem -->
  <path d="M50 79 L60 87 L70 79 L66 75 H54 Z" fill="#b83a3a"/>
  <path d="M33 140 Q60 149 87 140 L88 146 Q60 155 32 146 Z" fill="#b83a3a"/>

  <!-- right arm (resting) -->
  <path d="M80 94 q9 20 7 42" stroke="#d64545" stroke-width="12" fill="none" stroke-linecap="round"/>
  <circle cx="87" cy="140" r="7" fill="#c68a5a"/>

  <!-- head -->
  <rect x="53" y="66" width="14" height="14" rx="5" fill="#c68a5a"/>
  <circle cx="60" cy="46" r="23" fill="#c68a5a"/>
  <!-- curly hair: cluster of blobs -->
  <g fill="#2b1d16">
    <circle cx="44" cy="32" r="10"/>
    <circle cx="56" cy="26" r="11"/>
    <circle cx="69" cy="28" r="10"/>
    <circle cx="78" cy="37" r="8"/>
    <circle cx="40" cy="43" r="6"/>
    <circle cx="80" cy="47" r="5"/>
    <path d="M38 34 q22 -16 44 0 v10 h-44 Z"/>
  </g>
  <!-- ears -->
  <circle cx="38" cy="50" r="4.5" fill="#c68a5a"/>
  <circle cx="82" cy="50" r="4.5" fill="#c68a5a"/>
  <!-- round glasses -->
  <circle cx="51" cy="50" r="7.5" fill="none" stroke="#17181c" stroke-width="2.4"/>
  <circle cx="69" cy="50" r="7.5" fill="none" stroke="#17181c" stroke-width="2.4"/>
  <path d="M58.5 50 h3 M43.5 49 l-5 -1 M76.5 49 l5 -1" stroke="#17181c" stroke-width="2.4" fill="none"/>
  <!-- eyes, brows, smile -->
  <circle cx="51" cy="50" r="2.4" fill="#17181c"/>
  <circle cx="69" cy="50" r="2.4" fill="#17181c"/>
  <path d="M46 40 q5 -3 9 -1 M65 39 q5 -2 9 1" stroke="#2b1d16" stroke-width="2" fill="none" stroke-linecap="round"/>
  <path d="M55 62 q5 4 10 0" stroke="#8a5a34" stroke-width="2" fill="none" stroke-linecap="round"/>
</svg>

<style>
  .mascot {
    position: absolute;
    left: 4%;
    bottom: 0;
    width: min(168px, 18vw);
    z-index: 2; /* above the hero's bottom fade, still behind .hero-inner content */
    opacity: 0.97;
  }
  @media (max-width: 720px) {
    .mascot { width: 104px; left: 2%; opacity: 0.65; }
  }

  /* wave: raise, three waves, lower — plays once on load (~3.6s) */
  .wave-arm {
    transform-box: view-box;
    transform-origin: 40px 96px; /* shoulder */
    animation: mascot-wave 3.6s ease-in-out 0.6s 1;
  }
  @keyframes mascot-wave {
    0%        { transform: rotate(0deg); }
    14%       { transform: rotate(150deg); }
    26%       { transform: rotate(120deg); }
    38%       { transform: rotate(155deg); }
    50%       { transform: rotate(120deg); }
    62%       { transform: rotate(155deg); }
    74%       { transform: rotate(135deg); }
    92%, 100% { transform: rotate(0deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wave-arm { animation: none; }
  }
</style>
